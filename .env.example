# =================== Lyralo server env ===================
# Copy to .env and fill in real values. Never commit .env.

# --- Core ---
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://app.lyralo.com    # public URL of THIS server (used in emails + Suno callback)

# --- Database (Postgres) ---
# Fly.io / Render / Coolify provision this for you. Local dev:
# DATABASE_URL=postgres://lyralo:lyralo@localhost:5432/lyralo
DATABASE_URL=

# --- Admin auth ---
JWT_SECRET=change-me-to-a-long-random-string-please-32+chars
# bootstrap one admin: `node db/seed-admin.js admin@lyralo.com YourPassword`
SEED_ADMIN_EMAIL=admin@lyralo.com
SEED_ADMIN_PASSWORD=

# --- Anthropic (lyrics generation) ---
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# --- Suno (song generation) ---
# Pick a provider: sunoapi.org, acedata.cloud, suno-api.com, etc.
SUNO_API_BASE=https://api.sunoapi.org
SUNO_API_KEY=
SUNO_MODEL=V4
SUNO_CALLBACK_URL=https://app.lyralo.com/webhooks/suno   # optional

# --- Suno polling ---
POLL_INTERVAL_MS=30000   # check every 30s
START_POLLER=true        # set to "false" if you run a separate worker

# --- Shopify ---
SHOPIFY_WEBHOOK_SECRET=         # found in Shopify admin → Settings → Notifications → Webhooks
SHOPIFY_SHOP_DOMAIN=lyralo.myshopify.com
SHOPIFY_ADMIN_TOKEN=            # optional, only if you use appendCustomerNote()

# --- Email (Resend.com — cheapest reliable) ---
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=Lyralo <hello@lyralo.com>
